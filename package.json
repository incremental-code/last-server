{
  "name": "@incremental-code/last-server",
  "version": "0.0.1",
  "description": "Zero-config dev server with JSX support, built on last-router and last-act.",
  "type": "module",
  "bin": {
    "last-server": "./bin/last-server.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./compile": "./src/compile.js"
  },
  "scripts": {
    "demo": "node bin/last-server.js demo/src",
    "test": "node --test \"src/tests/*.test.js\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@incremental-code/last-act": "^0.0.1",
    "@incremental-code/last-router": "^0.0.1",
    "esbuild": "^0.24.0",
    "signal-polyfill": "^0.2.2"
  }
}
